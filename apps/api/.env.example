# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Stripe Price IDs (get these from your Stripe dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_id"
STRIPE_PRO_YEARLY_PRICE_ID="price_pro_yearly_id"
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID="price_enterprise_monthly_id"
STRIPE_ENTERPRISE_YEARLY_PRICE_ID="price_enterprise_yearly_id"

# Trial Configuration
STRIPE_TRIAL_DAYS=14

# JWT
JWT_SECRET="your-jwt-secret-here"

# Application URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# OAuth — Google
# Obtener en: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# OAuth — GitHub
# Obtener en: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Redis (for rate limiting and caching)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Email Configuration (optional)
EMAIL_SERVICE="sendgrid"
EMAIL_API_KEY="your_email_api_key"
EMAIL_FROM="noreply@yourapp.com"

# Monitoring (optional)
SENTRY_DSN="your_sentry_dsn"
LOG_LEVEL="info"

# Environment
NODE_ENV="development"